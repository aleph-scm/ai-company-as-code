# Example AppArmor profile for agent-bwrap's dedicated bwrap copy.
#
# Ubuntu 24.04 (and other hosts with kernel.apparmor_restrict_unprivileged_userns=1,
# the current Ubuntu default) blocks unprivileged user-namespace creation unless
# the calling binary has a matching AppArmor profile. bwrap needs a user
# namespace to build its sandbox, so on such a host the *system* bwrap binary
# stays permission-denied ("setting up uid map: Permission denied") unless you
# either flip that sysctl host-wide (broad blast radius — do not do this) or
# grant `userns` to a specific binary via a profile like this one.
#
# The recommended pattern: install a dedicated copy of bwrap that only this
# profile applies to, so the system /usr/bin/bwrap remains restricted and the
# grant is scoped to this one path:
#
#   sudo install -d -m 755 /usr/local/lib/agent-bwrap
#   sudo install -m 750 -o root -g agent-bwrap /usr/bin/bwrap /usr/local/lib/agent-bwrap/bwrap
#   sudo install -m 644 -o root -g root apparmor/agent-bwrap.profile.example /etc/apparmor.d/agent-bwrap
#   sudo apparmor_parser -r /etc/apparmor.d/agent-bwrap
#
# Replace /usr/local/lib/agent-bwrap/bwrap below if you install the profiled
# copy at a different path, and point BWRAP_BIN at that same path when running
# bin/agent-bwrap. Group-owning the copy 0750 <group> restricts execution to
# members of <group> — pick a group scoped to the agents you intend to confine,
# not a broad group like sudo/adm.
#
# On hosts that do NOT restrict unprivileged user namespaces (many CI runners,
# and many non-Ubuntu distros), none of this is required — bin/agent-bwrap
# works with the unmodified system bwrap and BWRAP_BIN can default to plain
# "bwrap" resolved from PATH.

abi <abi/4.0>,
include <tunables/global>

profile agent-bwrap /usr/local/lib/agent-bwrap/bwrap flags=(unconfined) {
  userns,
  include if exists <local/agent-bwrap>
}
